# Copy to .env before running `docker compose up`.
# This template is tuned for a local DEMO. For production read docs/SECURITY.md:
# ENV=production, DEMO_MODE=false, COOKIE_SECURE=true, strong secrets, real LLM key.

ENV=development
DEBUG=false
DEMO_MODE=true
SEED_ON_STARTUP=true
# Set to false once you create real users — the demo institution is for review only.

POSTGRES_PASSWORD=change-this-database-password

# Generate: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
# Generate: openssl rand -base64 32   (the value is base64 of 32 random bytes)
MASTER_KEY=
MASTER_KEY_ID=docker-key-1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional: a real provider switches the platform out of DEMO generation mode.
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
EMBEDDING_PROVIDER=auto

GEN_INLINE=true
RELEASE_WINDOW_MINUTES=120
PRINT_EARLY_OPEN_MINUTES=1440

# --- Production (Railway + Supabase + Gemini): see docs/DEPLOYMENT.md -------
# ENV=production
# DEMO_MODE=false
# COOKIE_SECURE=true
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=<gemini chat model id>
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_API_DIMENSIONS=768
# STORAGE_BACKEND=s3
# S3_BUCKET= / S3_ENDPOINT_URL= / S3_REGION= / S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY=
# TRUSTED_PROXY_COUNT=2
