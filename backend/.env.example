# --- Runtime -------------------------------------------------------------
ENV=development
DEBUG=false
DEMO_MODE=true
SEED_ON_STARTUP=false

# --- Security (REQUIRED in production) -----------------------------------
JWT_SECRET=replace-with-at-least-32-random-characters
MASTER_KEY_ID=key-2026-01
# printf '%s' "$(openssl rand -base64 32)" | base64 -w0  -> set MASTER_KEY to that base64
MASTER_KEY=
MASTER_KEYS_JSON=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Database ------------------------------------------------------------
DATABASE_URL=sqlite:///./var/app.db
# DATABASE_URL=postgresql+psycopg://praxis:praxis@localhost:5432/praxis

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI (optional; DEMO_MODE uses the grounded template provider) -------
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# --- Storage -------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/storage
# S3_BUCKET=praxis-papers
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Generation / release ------------------------------------------------
GEN_INLINE=true
RELEASE_WINDOW_MINUTES=120
PRINT_EARLY_OPEN_MINUTES=1440
